    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  '{{ $json.payDesc }}' AS \"payDesc\",\n    metadata->>'sender_name' AS sender,\n    (metadata->>'created_at_gmt7')::timestamptz AS payment_date,\n    metadata->>'source' AS source,\n    content\nFROM telegram_knowledge\nWHERE (content ILIKE '%pending payment%' OR content ILIKE '%verified payout proof%' OR content ILIKE  '%invoice / bill%')\n  AND metadata->>'source' = 'payout_proof'\n  AND (metadata->>'created_at_gmt7')::timestamptz >= date_trunc('month', CURRENT_TIMESTAMP) - INTERVAL '1 month'\n  AND (metadata->>'created_at_gmt7')::timestamptz <  date_trunc('month', CURRENT_TIMESTAMP)\nORDER BY (metadata->>'created_at_gmt7')::timestamptz DESC;",
        "options": {}
