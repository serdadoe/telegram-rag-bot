    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Gemini's raw text can land on different fields depending on n8n/node version -\n// check the actual output in a test run and trim this fallback list down.\nlet raw = $json.content.parts[0].text\n  ?? $json.content\n  ?? $json.data\n  ?? $json.candidates?.[0]?.content?.parts?.[0]?.text\n  ?? '';\n\nraw = String(raw).replace(/```json|```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = {\n    Category: 'other',\n    Paying_Company: '',\n    Amount: '',\n    Date: '',\n    Payment_Method: ''\n  };\n}\n\nparsed.is_verified_payout = ['paid', 'bill_invoice', 'pending'].includes(parsed.Category);\n\nreturn { json: parsed };"
      },
