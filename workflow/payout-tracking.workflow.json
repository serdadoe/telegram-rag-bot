    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const trigger = $('Telegram Trigger').item.json.message;\nconst parsed = $json;\n\nconst category = parsed.Category || 'paid';\nconst label = {\n  paid: 'Verified payment',\n  pending: 'Pending payment',\n  bill_invoice: 'Invoice / bill'\n}[category] || 'Payment record';\n\nconst payingCompany = parsed.Paying_Company || '';\nconst amount = parsed.Amount || 'not specified';\nconst method = parsed.Payment_Method || '';\nconst date = parsed.Date || '';\nconst firstName = trigger.from.first_name || '';\nconst originalPost = `https://t.me/c/YOUR_GROUP_ID/${trigger.message_thread_id ?? 1}/${trigger.message_id}`;\n\nconst pageContent = `${label} — ${method ? 'Method: ' + method + ' | ' : ''}Amount: ${amount}${payingCompany ? ' | From: ' + payingCompany : ''}${date ? ' | Date: ' + date : ''} | Posted by: ${firstName}`;\n\nreturn {\n  json: {\n    pageContent,\n    metadata: {\n      source: 'payout_proof',\n      category,\n      chat_id: trigger.chat.id,\n      message_id: trigger.message_id,\n      thread_id: trigger.message_thread_id ?? null,\n      sender: firstName,\n      paying_company: payingCompany,\n      amount,\n      payment_method: method,\n      date,\n      original_post: originalPost,\n      timestamp: new Date(trigger.date * 1000).toISOString()\n    }\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
