    {
      "parameters": {
        "jsCode": "// 1. Get all items from the previous SQL node\nlet items = $input.all();\n\n// Sort by date: Newest (latest) at the top\nitems.sort((a, b) => new Date(b.json.payment_date) - new Date(a.json.payment_date));\n\n// Helper to escape HTML characters safely for Telegram\nconst escapeHtml = (str) => \n  (str || '')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n\n// Get payDesc from the first item, fallback if missing\nconst title = escapeHtml(items[0]?.json?.payDesc || 'Payments');\n\nlet message = `💳 <b>${title}</b>\\n\\n`;\n\n// 2. Loop through each item\nitems.forEach((item) => {\n  const p = item.json;\n  \n  // Format date to \"Jul 15, 2026\"\n  const date = new Date(p.payment_date).toLocaleDateString('en-US', {\n    month: 'short',\n    day: '2-digit',\n    year: 'numeric'\n  });\n\n  const sender = escapeHtml(p.sender);\n\n  // Extract Amount and From fields from content\n  const amountMatch = p.content.match(/Amount:\\s*([^|]+)/i);\n  const fromMatch = p.content.match(/From:\\s*([^|]+)/i);\n\n  let detail = '';\n\n  if (amountMatch) {\n    const amount = amountMatch[1].trim();\n    const from = fromMatch ? fromMatch[1].trim() : '';\n    \n    // If 'From' exists: \"33210 IDR from Uber\", otherwise just \"$307.91\"\n    detail = from ? `${amount} from ${from}` : amount;\n  } else {\n    // Clean fallback if \"Amount:\" tag isn't explicitly present\n    detail = p.content\n      .replace(/^(Pending payment|Verified payout proof|Invoice \\/ Bill)\\s*—\\s*/gi, '')\n      .replace(/\\b(Method|Amount|From):[^|]*\\|\\s*/gi, '')\n      .replace(/\\s*\\|\\s*(Date|Posted by):[^|]*/gi, '')\n      .trim();\n  }\n\n  // Uniform Output: Aug 19, 2026 : Dikta — 33210 IDR from Uber\n  message += `<b>${date}</b> : <b>${sender}</b> — ${escapeHtml(detail)}\\n`;\n});\n\n// 3. Return as an array of objects for n8n\nreturn [\n  {\n    json: {\n      telegram_message: message.trim()\n    }\n  }\n];"
      },
