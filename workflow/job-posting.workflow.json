    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const msg = item.json.message || {};\n  const text = msg.text || '';\n  const urlEntity = (msg.entities || []).find(e => e.type === 'url');\n\n  const link = urlEntity\n    ? text.substring(urlEntity.offset, urlEntity.offset + urlEntity.length)\n    : (text.match(/https?:\\/\\/\\S+/)?.[0] ?? null);\n\n  item.json.link = link;\n  item.json.linkClean = link\n    ? link.replace(/^https?:\\/\\//i, '').replace(/^www\\./i, '')\n    : null;\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1344,
        -304
      ],
      "id": "b64d6aaf-0096-4537-940b-7998410118d4",
