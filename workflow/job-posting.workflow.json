    {
      "parameters": {
        "jsCode": "const trigger = $('Telegram Trigger').item.json.message;\nconst output = $json.output;\n\nconst role = output.Role || 'Unknown role';\nconst platform = output.Platform || '';\nconst link = output.Link || '';\nconst rate = output.Rate || 'not specified';\nconst description = output.Job_Description || '';\nconst firstName = trigger.from.first_name || output.Posted_By_First_Name || '';\nconst originalPost = `https://t.me/c/YOUR_GROUP_ID/${trigger.message_thread_id ?? 1}/${trigger.message_id}`;\n\nconst pageContent = `Job opening — Role: ${role}${platform ? ' | Platform: ' + platform : ''} | Rate: ${rate}\\n${description}${link ? '\\nLink: ' + link : ''}\\nPosted by: ${firstName}`;\n\nreturn {\n  json: {\n    pageContent,\n    metadata: {\n      source: 'job_posting',\n      chat_id: trigger.chat.id,\n      message_id: trigger.message_id,\n      thread_id: trigger.message_thread_id ?? null,\n      sender: firstName,\n      role,\n      platform,\n      rate,\n      link,\n      original_post: originalPost,\n      timestamp: new Date(trigger.date * 1000).toISOString()\n    }\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -320,
        -304
      ],
      "id": "514099fa-37b3-4de9-babe-bcb6c2167d5b",
