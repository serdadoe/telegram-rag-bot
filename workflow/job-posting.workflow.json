    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the following Telegram message and link context to extract job posting details.\n\n---\nMessage / Web Context:\n{{ $json.data }}\n",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an AI assistant designed to analyze incoming messages or web content and determine if they describe a job opening/hiring post.\n\nYour task:\n1. Determine if the text represents a legitimate job opening, freelance gig, or hiring request.\n2. If it IS a job opening, extract the relevant fields and set \"is_job_opening\" to true.\n3. If it IS NOT a job opening (e.g., spam, general chat, someone seeking a job, promotional material), set \"is_job_opening\" to false and use empty strings for the detail fields."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -880,
        -304
      ],
      "id": "2ae5e092-dd66-4d97-8db0-35d8a3a3d3e0",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.1-flash-lite",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        -880,
        -112
      ],
      "id": "83620eed-e5ee-419a-afd8-6766ff73d754",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "8hvw9GQPPFc4G9HD",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"is_job_opening\": {\n      \"type\": \"boolean\",\n      \"description\": \"True if this post is a job opening or hiring call, false otherwise\"\n    },\n    \"Role\": {\n      \"type\": \"string\",\n      \"description\": \"Job title or role name. Use an empty string if no role is provided.\"\n    },\n    \"Platform\": {\n      \"type\": \"string\",\n      \"description\": \"Name of the platform or company mentioned (e.g., Mercor, Turing, Upwork, LinkedIn, direct Telegram hire), with no spaces. Use an empty string if none is provided.\"\n    },\n    \"Link\": {\n      \"type\": \"string\",\n      \"description\": \"Extracted URL/link included in the post. Use an empty string if no link is provided.\"\n    },\n    \"Rate\": {\n      \"type\": \"string\",\n      \"description\": \"Salary, rate, or compensation details. Use an 'not specified' if none is provided.\"\n    },\n    \"Job_Description\": {\n      \"type\": \"string\",\n      \"description\": \"Focus strictly on day-to-day responsibilities and tasks. If specific daily tasks aren't provided, summarize what the hiring platform or company does instead. Use an empty string if not applicable.\"\n    },\n    \"Posted_By_First_Name\": {\n      \"type\": \"string\",\n      \"description\": \"First name of the sender. Use an empty string if unknown.\"\n    }\n  },\n  \"required\": [\n    \"is_job_opening\",\n    \"Role\",\n    \"Platform\",\n    \"Link\",\n    \"Rate\",\n    \"Job_Description\",\n    \"Posted_By_First_Name\"\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        -704,
        -112
      ],
      "id": "18ae9c40-6f52-47db-b655-87613cab1e90",
