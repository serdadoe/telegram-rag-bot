    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=🔎✨ <b>NEW JOB OPENING</b> ✨🔎\n\n👤 Role: <b>{{ $('Job Opening Only').item.json.output.Role }}</b>\n🏢 Platform: {{ $('Job Opening Only').item.json.output.Platform }}\n🔗 Link: {{ $('Job Opening Only').item.json.output.Link }}\n💰 Rate: <b>{{ $('Job Opening Only').item.json.output.Rate }}</b>\n\n📝 Description: <i>{{ $('Job Opening Only').item.json.output.Job_Description }}</i>\n\n----------\n📩 Posted By: <b><a href=\"tg://user?id={{ $('Telegram Trigger').item.json.message.from.id }}\">@{{ $('Telegram Trigger').item.json.message.from.first_name }}</a></b>\n📌 Original Post: <a href=\"https://t.me/c/YOUR_GROUP_ID/{{ $('Telegram Trigger').item.json.message.message_thread_id ?? 1 }}/{{ $('Telegram Trigger').item.json.message.message_id }}\">here</a>\n\n#jobposting #lowongan #{{ $('Job Opening Only').item.json.output.Platform }}",
