    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet contextBlock = '';\nconst sourceLinks = {};\n\nitems.forEach((item, index) => {\n  const num = index + 1;\n  const meta = item.json.metadata || {};\n  const chatId = String(meta.chat_id || '').replace(/^-100/, '');\n  const messageId = meta.message_id;\n  const sender = meta.sender_name || meta.username || 'unknown';\n\n  contextBlock += `[${num}] ${sender}: ${item.json.content}\\n\\n`;\n\n  if (chatId && messageId) {\n    sourceLinks[num] = `https://t.me/c/${chatId}/${messageId}`;\n  }\n});\n\nreturn { json: { context: contextBlock, sourceLinks } };"
      },
