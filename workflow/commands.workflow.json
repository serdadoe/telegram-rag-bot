    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, created_at, content, metadata, '{{ $json.cmdDesc }}' AS cmd_desc\nFROM public.telegram_knowledge\nWHERE (metadata->>'created_at_gmt7')::timestamp >= \n      (NOW() AT TIME ZONE 'Asia/Jakarta') - (INTERVAL '1 hour' * {{ $json.hoursAgo }})\n  AND metadata->>'thread_id' IS NOT NULL\n  AND metadata->>'thread_id' <> ''\n  {{ $('Telegram Trigger').item.json.message?.message_thread_id ? \"AND (metadata->>'thread_id')::bigint = \" + $('Telegram Trigger').item.json.message.message_thread_id : \"\" }}\nORDER BY (metadata->>'created_at_gmt7')::timestamp DESC;",
        "options": {}
      },
