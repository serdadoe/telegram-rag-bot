    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/setMessageReaction",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('Telegram Trigger').item.json.message.chat.id }}\",\n  \"message_id\": \"{{ $('Telegram Trigger').item.json.message.message_id }}\",\n  \"reaction\": [{ \"type\": \"emoji\", \"emoji\": \"👀\" }]\n}",
