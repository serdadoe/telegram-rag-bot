    {
      "parameters": {
        "jsCode": "function sanitizeTelegramHtml(html) {\n  let out = html;\n  // Convert list markup to bullet lines, in case the model still emits it\n  out = out.replace(/<li[^>]*>/gi, '• ');\n  out = out.replace(/<\\/li>/gi, '\\n');\n  out = out.replace(/<\\/?(ul|ol)[^>]*>/gi, '');\n  // Common block-level tags become line breaks\n  out = out.replace(/<br\\s*\\/?>/gi, '\\n');\n  out = out.replace(/<\\/p>/gi, '\\n');\n  out = out.replace(/<p[^>]*>/gi, '');\n  out = out.replace(/<\\/?div[^>]*>/gi, '');\n  out = out.replace(/<\\/?(h[1-6]|span|table|tr|td|th|thead|tbody)[^>]*>/gi, '');\n  // Strip anything not in Telegram's actual whitelist\n  const allowed = ['b', 'strong', 'i', 'em', 'u', 'ins', 's', 'strike', 'del', 'a', 'code', 'pre', 'blockquote', 'tg-spoiler'];\n  out = out.replace(/<\\/?([a-zA-Z0-9-]+)([^>]*)>/g, (match, tag) => {\n    return allowed.includes(tag.toLowerCase()) ? match : '';\n  });\n  return out;\n}\n\nconst answer = $input.first().json.content.parts[0].text;\nconst sourceLinks = $('Get Source Link').first().json.sourceLinks;\n\nlet linkedAnswer = answer.replace(/\\[(\\d+)\\]/g, (match, num) => {\n  const url = sourceLinks[num];\n  return url ? `<a href=\"${url}\">[${num}]</a>` : match;\n});\n\nlinkedAnswer = sanitizeTelegramHtml(linkedAnswer);\n\nreturn { json: { ...$json, linkedAnswer } };"
      },
