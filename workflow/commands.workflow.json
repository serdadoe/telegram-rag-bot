    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH RECURSIVE\nvector_seed AS (\n  SELECT id, content, metadata, created_at,\n         row_number() OVER (ORDER BY similarity DESC) AS rnk\n  FROM match_documents_v2(\n    '[{{ $json.embedding.values.join(\",\") }}]'::vector,\n    40,\n    YOUR_GROUP_CHAT_ID\n  )\n),\nkeyword_seed AS (\n  SELECT id, content, metadata, created_at,\n         row_number() OVER (ORDER BY ts_rank(content_tsv, query) DESC) AS rnk\n  FROM public.telegram_knowledge, to_tsquery('simple', '{{ $json.keywordPattern }}') query\n  WHERE chat_id = YOUR_GROUP_CHAT_ID\n    AND '{{ $json.keywordPattern }}' <> ''\n    AND content_tsv @@ query\n  ORDER BY ts_rank(content_tsv, query) DESC\n  LIMIT 40\n),\nfused AS (\n  SELECT\n    COALESCE(v.id, k.id) AS id,\n    COALESCE(v.content, k.content) AS content,\n    COALESCE(v.metadata, k.metadata) AS metadata,\n    COALESCE(v.created_at, k.created_at) AS created_at,\n    (1.0 / (60 + COALESCE(v.rnk, 1000))) + (1.0 / (60 + COALESCE(k.rnk, 1000))) AS hybrid_score\n  FROM vector_seed v\n  FULL OUTER JOIN keyword_seed k ON v.id = k.id\n),\nall_seed AS (\n  (SELECT id, content, metadata, created_at, hybrid_score\n   FROM fused ORDER BY hybrid_score DESC LIMIT 15)\n\n  UNION\n\n  (SELECT f.id, f.content, f.metadata, f.created_at, f.hybrid_score\n   FROM vector_seed v JOIN fused f ON v.id = f.id\n   WHERE v.rnk <= 10)\n\n  UNION\n\n  (SELECT f.id, f.content, f.metadata, f.created_at, f.hybrid_score\n   FROM keyword_seed k JOIN fused f ON k.id = f.id\n   WHERE k.rnk <= 10)\n),\nancestors AS (\n  SELECT tk.id, tk.content, tk.metadata, tk.created_at, tk.message_id, tk.reply_to_message_id, tk.chat_id, 0 AS depth, s.hybrid_score\n  FROM public.telegram_knowledge tk JOIN all_seed s ON tk.id = s.id\n  UNION ALL\n  SELECT parent.id, parent.content, parent.metadata, parent.created_at, parent.message_id, parent.reply_to_message_id, parent.chat_id, a.depth + 1, a.hybrid_score\n  FROM public.telegram_knowledge parent\n  JOIN ancestors a ON parent.message_id = a.reply_to_message_id AND parent.chat_id = a.chat_id\n  WHERE a.depth < 10\n),\ndescendants AS (\n  SELECT tk.id, tk.content, tk.metadata, tk.created_at, tk.message_id, tk.reply_to_message_id, tk.chat_id, 0 AS depth, s.hybrid_score\n  FROM public.telegram_knowledge tk JOIN all_seed s ON tk.id = s.id\n  UNION ALL\n  SELECT child.id, child.content, child.metadata, child.created_at, child.message_id, child.reply_to_message_id, child.chat_id, d.depth + 1, d.hybrid_score\n  FROM public.telegram_knowledge child\n  JOIN descendants d ON child.reply_to_message_id = d.message_id AND child.chat_id = d.chat_id\n  WHERE d.depth < 10\n),\ncombined AS (\n  SELECT DISTINCT ON (id) id, content, metadata, created_at, hybrid_score\n  FROM (\n    SELECT id, content, metadata, created_at, hybrid_score FROM ancestors\n    UNION ALL\n    SELECT id, content, metadata, created_at, hybrid_score FROM descendants\n  ) u\n  ORDER BY id, hybrid_score DESC NULLS LAST\n)\nSELECT id, content, metadata, created_at, hybrid_score\nFROM combined\nORDER BY hybrid_score DESC NULLS LAST, created_at;",
        "options": {}
      },
