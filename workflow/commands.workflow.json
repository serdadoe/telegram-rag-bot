        "jsCode": "const stopwords = new Set([\n  'yang','dari','siapa','apa','ke','di','dan','atau','ini','itu','untuk',\n  'dengan','saja','aja','dong','sih','ya','nya','adalah','akan','bisa',\n  'ada','tersebut','pada','juga','saat','kapan','berapa','bagaimana',\n  'who','what','where','when','is','are','the','a','an','from','of',\n  'in','on','to','for','and','or','how','much','many','does','did','ask'\n]);\n\nconst question = ($json.query || '').toLowerCase();\n\nconst tokens = question.match(/\\d+(\\.\\d+)?|[a-z]+/g) || [];\nconst keywords = tokens.filter(w => w.length >= 3 && !stopwords.has(w));\n\nconst keywordPattern = keywords.join(' | ');\n\nreturn { json: { ...$json, keywordPattern } };"
      },
